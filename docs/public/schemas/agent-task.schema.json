{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limecloud.github.io/agentnovel/schemas/agent-task.schema.json",
  "title": "Agent Novel Task",
  "type": "object",
  "required": [
    "taskId",
    "surface",
    "intent"
  ],
  "properties": {
    "taskId": {
      "type": "string"
    },
    "surface": {
      "type": "string",
      "enum": [
        "analysis",
        "canon",
        "feature-center",
        "home",
        "knowledge",
        "publish",
        "revision",
        "writing"
      ]
    },
    "intent": {
      "type": "string"
    },
    "targetRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextBudget": {
      "type": "object",
      "additionalProperties": true
    },
    "allowedTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "writePolicy": {
      "type": "string",
      "enum": [
        "read-only",
        "propose-only",
        "approval-required",
        "policy-allowed"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "taskType": {
      "type": "string",
      "enum": [
        "write_chapter",
        "rewrite_selection",
        "extract_canon",
        "answer_knowledge",
        "diagnose_story",
        "simulate_impact",
        "create_intent_plan",
        "map_reader_feedback",
        "plan_timeline_iteration",
        "prepare_publish"
      ]
    },
    "harnessMode": {
      "type": "string",
      "enum": [
        "sandbox",
        "timeline"
      ]
    }
  },
  "additionalProperties": true
}
