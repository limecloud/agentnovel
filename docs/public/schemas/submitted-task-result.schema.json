{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limecloud.github.io/agentnovel/schemas/submitted-task-result.schema.json",
  "title": "Submitted Task Result",
  "type": "object",
  "required": [
    "status",
    "summary",
    "artifacts"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "waiting_approval"
      ]
    },
    "summary": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "https://limecloud.github.io/agentnovel/schemas/agent-feed-item.schema.json"
      }
    }
  },
  "additionalProperties": true
}
