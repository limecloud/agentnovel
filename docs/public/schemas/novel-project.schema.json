{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limecloud.github.io/agentnovel/schemas/novel-project.schema.json",
  "title": "Agent Novel Project",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectId",
    "title",
    "language",
    "currentChapterId",
    "chapters"
  ],
  "properties": {
    "schemaVersion": {
      "type": [
        "integer",
        "string"
      ]
    },
    "projectId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "premise": {
      "type": "string"
    },
    "currentSurface": {
      "type": "string"
    },
    "currentFeatureTool": {
      "type": "string"
    },
    "currentChapterId": {
      "type": "string"
    },
    "publishState": {
      "type": "object",
      "additionalProperties": true
    },
    "volumes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/volume"
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chapter"
      }
    },
    "homeHighlights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "detail"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "quickActions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "prompt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "sandbox",
            "timeline"
          ]
        },
        "publishedChapterRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lockedChapterRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "switchedAt": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "harnessProfile": {
      "$ref": "https://limecloud.github.io/agentnovel/schemas/harness-profile.schema.json"
    }
  },
  "$defs": {
    "volume": {
      "type": "object",
      "required": [
        "volumeId",
        "order",
        "title"
      ],
      "properties": {
        "volumeId": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "chapter": {
      "type": "object",
      "required": [
        "chapterId",
        "file",
        "order",
        "title",
        "summary",
        "status",
        "wordCount",
        "objective",
        "scenes"
      ],
      "properties": {
        "chapterId": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "volumeId": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "wordCount": {
          "type": "integer"
        },
        "objective": {
          "type": "string"
        },
        "lastEditedAt": {
          "type": "string"
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scene"
          }
        },
        "publishedAt": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "scene": {
      "type": "object",
      "required": [
        "sceneId",
        "order",
        "title",
        "goal",
        "status"
      ],
      "properties": {
        "sceneId": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
